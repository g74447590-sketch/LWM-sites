# Public URL of this application, for example https://app.example.com
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Supabase server-side credentials. Never expose the secret key in the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Compatibility with legacy Supabase projects.
SUPABASE_SERVICE_ROLE_KEY=

# Password-recovery email sent through Resend (optional until password recovery is enabled).
RESEND_API_KEY=
EMAIL_FROM=LWM Sites <no-reply@example.com>
LWM_TOKEN_BILLING_ENABLED=false
